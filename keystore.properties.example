# Release 签名配置模板
# 使用方法：复制本文件为 keystore.properties 并填写真实值。
# keystore.properties 已被 .gitignore 排除，不会提交到仓库。
#
# 生成密钥（参考 README「Release 签名」）：
#   keytool -genkeypair -v -keystore release.keystore -alias air -keyalg RSA -keysize 2048 -validity 10000
#
# 注意：密钥丢失后无法发布升级包，请务必离线备份！

storeFile=release.keystore
storePassword=change_me
keyAlias=air
keyPassword=change_me
